<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="AlphaPay Laravel SDK">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <!-- Pas de bloc source/coverage : l'élément "source" n'existe qu'à partir de
         PHPUnit 10 (avertissement de schéma sous PHPUnit 9, cf. composer.json
         qui supporte 9.5, 10.5 et 11 pour couvrir Laravel 9 à 12). La portée
         de couverture par défaut suffit, pas besoin d'un fichier par version. -->
</phpunit>
